server {
    listen ${NGINX_PORT};
    server_name _;

    root /app/web;
    index index.html;

    location = /health {
        access_log off;
        return 204;
    }

    location ~ ^/(admin|login|initialize)(/.*)?$ {
        try_files /$1.html =404;
    }

    location ~* ^/(uploads|languages|themes|plugins)/(.*)$ {
        alias /app/content/$1/$2;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
