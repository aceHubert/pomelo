server {
    listen ${NGINX_PORT};
    server_name _;

    root /app/clients/web;
    index index.html;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;

    location = /health {
        access_log off;
        return 204;
    }

    location = /action/basic {
        proxy_pass http://127.0.0.1:3002/;
    }

    location ^~ /action/basic/ {
        proxy_pass http://127.0.0.1:3002/;
    }

    location ~ ^/admin(/.*)?$ {
        try_files /admin.html =404;
    }

    location = /initialize {
        root /app/clients;
        try_files /initialize/index.html =404;
    }

    location ^~ /initialize/ {
        root /app/clients;
        try_files $uri $uri/ /initialize/index.html;
    }

    location = /auth {
        root /app/clients;
        try_files /auth/index.html =404;
    }

    location ^~ /auth/ {
        root /app/clients;
        try_files $uri $uri/ /auth/index.html;
    }

    location = /login {
        root /app/clients;
        try_files /auth/index.html =404;
    }

    location ^~ /login/ {
        root /app/clients;
        try_files /auth/index.html =404;
    }

    location ~* ^/(uploads|languages|themes|plugins)/(.*)$ {
        alias /app/content/$1/$2;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
