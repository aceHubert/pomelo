user nginx;
worker_processes ${NGINX_WORKER_PROCESSES};

error_log /dev/stderr warn;
pid /run/nginx/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '>>>{"timestamp":"$time_iso8601", "remote_addr":"$remote_addr", "request_method":"$request_method", "request":"$request_uri", "status":"$status", "body_bytes_sent":"$body_bytes_sent", "request_time":"$request_time", "http_user_agent":"$http_user_agent"}';

    access_log /dev/stdout main;

    sendfile on;
    keepalive_timeout ${NGINX_KEEPALIVE_TIMEOUT};
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    include /etc/nginx/conf.d/*.conf;
}
