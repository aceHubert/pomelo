# Docker image configuration
IMAGE_REPOSITORY=ghcr.io/acehubert/pomelo:latest
OIDC_IMAGE_REPOSITORY=ghcr.io/acehubert/pomelo-oidc:latest

# Application configuration
SWAGGER_DEBUG=false
GRAPHQL_DEBUG=false
# APISIX 对外访问域名，用于渲染 example/apisix/conf/apisix-standalone.yaml.template
ORIGIN=https://example.com
LOG_LEVEL=info
ACCOUNT_PROVIDER=direct-db

# Database configuration
INFRASTRUCTURE_DATABASE_CONNECTION=mysql://user:password@host:port/database
IDENTITY_DATABASE_CONNECTION=mysql://user:password@host:port/database
TABLE_PREFIX=po_

# Redis configuration
REDIS_URL=redis://host:port/db

# APISIX image tag
APISIX_IMAGE_TAG=3.13.0-debian

# External services configuration
MYSQL_CONTAINER_NAME=mysql-default-5.7
REDIS_CONTAINER_NAME=redis-default-7.2
MYSQL_NETWORK_NAME=mysql_default
REDIS_NETWORK_NAME=redis_default

# Service host configuration
POMERO_SERVER_HOST=pomelo-server
POMERO_IDENTITY_SERVER_HOST=pomelo-identity-server
POMERO_WEB_HOST_PORT=8080
POMERO_INFRASTRUCTURE_SERVICE_HOST_PORT=13000
POMERO_INFRASTRUCTURE_SERVICE_TCP_HOST_PORT=13001
POMERO_BFF_SERVER_HOST_PORT=13002
