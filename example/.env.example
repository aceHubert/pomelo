# Docker Compose 环境配置示例

# Docker image configuration
IMAGE_REPOSITORY=ghcr.io/acehubert/pomelo:latest
OIDC_IMAGE_REPOSITORY=ghcr.io/acehubert/pomelo-oidc:latest

# Application configuration
SWAGGER_DEBUG=false
GRAPHQL_DEBUG=false
# OIDC Authority，用于 APISIX discovery / issuer；allow_origins 会使用该地址计算出的 origin
AUTHORITY=https://example.com/oidc
OIDC_PATH=/oauth2
LOG_LEVEL=info
ACCOUNT_PROVIDER=database

# MySQL configuration
# Compose 会根据以下字段拼接 INFRASTRUCTURE_DATABASE_CONNECTION、
# IDENTITY_DATABASE_CONNECTION 和 USER_DATABASE_CONNECTION。
MYSQL_USER=pomelo
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306
INFRASTRUCTURE_DATABASE_NAME=po_template
IDENTITY_DATABASE_NAME=po_identity
INFRASTRUCTURE_DATABASE_TABLE_PREFIX=po_
IDENTITY_DATABASE_TABLE_PREFIX=po_

# Redis configuration
# Compose 会根据以下字段拼接 REDIS_URL，并只注入 identity-server。
REDIS_USER=default
REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_DB=0
REDIS_SENTINEL_PORT=26379
REDIS_SENTINEL_MASTER_NAME=mymaster
REDIS_SENTINEL_MASTER_HOST=127.0.0.1
REDIS_SENTINEL_QUORUM=2

# APISIX image tag
APISIX_IMAGE_TAG=3.13.0-debian
APISIX_CLIENT_ID=75a9c633-cfde-4954-b35c-9344ed9b781a

# External services configuration
MYSQL_CONTAINER_NAME=mysql-default-5.7
REDIS_CONTAINER_NAME=redis-default-7.2
MYSQL_NETWORK_NAME=mysql_default
REDIS_NETWORK_NAME=redis_default

# Service host configuration
POMERO_SERVER_HOST=pomelo-server
POMERO_IDENTITY_SERVER_HOST=pomelo-identity-server
POMERO_WEB_HOST_PORT=8080
POMERO_INFRASTRUCTURE_SERVICE_HOST_PORT=13000
POMERO_INFRASTRUCTURE_SERVICE_TCP_HOST_PORT=13001
POMERO_BFF_SERVER_HOST_PORT=13002
POMERO_IDENTITY_SERVER_HOST_PORT=15003
