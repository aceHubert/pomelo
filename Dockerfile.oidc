ARG NODE_VERSION="16.14.0-alpine"

FROM --platform=$BUILDPLATFORM node:${NODE_VERSION} AS base
LABEL maintainer="yi.xiang@live.cn"

FROM base AS builder
ADD . /app
WORKDIR /app

ARG BUILD_IGNORE="false"
ARG BUILD_OPTION="yarn build:identity-server"

RUN if [ "$BUILD_IGNORE" = "true" ]; then \
        set -x ; echo "Build ignored!"; \
    else \
        set -ex && yarn install --mode=skip-build && ${BUILD_OPTION}; \
    fi

FROM base AS runtime
COPY --from=builder /app/dist/servers/identity-server /app/identity-server/
COPY --from=builder /app/dist/servers/content /app/content/
COPY --from=builder /app/dist/servers/conf /app/conf/
COPY --from=builder /app/.yarn /app/.yarn/
COPY --from=builder /app/package*.json /app/.yarnrc.yml /app/yarn.lock /app/

WORKDIR /app
RUN yarn workspaces focus --production --all

FROM base AS deploy
ARG RUNTIME_ENV="production"

COPY --from=runtime /app/identity-server /app/identity-server/
COPY --from=runtime /app/content /app/content/
COPY --from=runtime /app/conf /app/conf/
COPY --from=runtime /app/node_modules /app/node_modules/

WORKDIR /app/identity-server
ENV NODE_ENV=${RUNTIME_ENV}
ENV PORT=3000
ENV GLOBAL_PREFIX_URI=/connect
ENV OIDC_PATH=/oauth2
ENV ACCOUNT_PROVIDER=direct-db

EXPOSE 3000
CMD ["node", "dist/main.js", "--sync"]
