# 启用experimental 特性
# DOCKER_CLI_EXPERIMENTAL=enabled
# 创建一个buildx 构建环境
# docker buildx create --use --name mutli-build
# 查看当前构建环境信息，以及支持的架构
# docker buildx inspect --bootstrap
# 构建镜像
# docker buildx build -t hubert007/pomelo-oidc:0.0.3 -t hubert007/pomelo-oidc:latest --target deploy --cache-from hubert007/pomelo-oidc:latest --build-arg BUILD_IGNORE=true --platform linux/amd64,linux/arm64 --push .
# 运行容器
# docker run -it -d -p 3003:3000 --name pomelo-oidc --rm hubert007/pomelo-oidc:0.0.3
# docker network connect --link mysql-default-5.7:mysql mysql_default pomelo-server
# docker network connect --link redis-default-6.2:redis redis_default pomelo-server

# 添加ARG参数，可在docker build时通过 --build-arg BUILD_OPTION="xxx" --build-arg  BUILD_PLATFORM="xxx"传入代码编译命令
# 容器 nodejs 版本
ARG NODE_VERSION="20.19.4-alpine"

FROM --platform=$BUILDPLATFORM node:${NODE_VERSION} AS base
LABEL maintainer="yi.xiang@live.cn"

FROM base AS builder
ADD . /app
WORKDIR /app

ARG BUILD_IGNORE="false"
ARG BUILD_OPTION="yarn build:identity-server"

RUN if [ "$BUILD_IGNORE" = "true" ]; then \
        set -x ; echo "Build ignored!"; \
    else \
        set -ex && yarn install --mode=skip-build && ${BUILD_OPTION}; \
    fi

FROM base AS runtime
COPY --from=builder /app/dist/servers/identity-server /app/identity-server/
COPY --from=builder /app/clients/identity-server-management/dist/management.html /app/identity-server/public/management.html
COPY --from=builder /app/dist/servers/content /app/content/
COPY --from=builder /app/.yarn /app/.yarn/
COPY --from=builder /app/package*.json /app/.yarnrc.yml /app/yarn.lock /app/

WORKDIR /app
RUN yarn workspaces focus --production --all

FROM base AS deploy
ARG RUNTIME_ENV="production"

COPY --from=runtime /app/identity-server /app/identity-server/
COPY --from=runtime /app/content /app/content/
COPY --from=runtime /app/node_modules /app/node_modules/

WORKDIR /app/identity-server
ENV NODE_ENV=${RUNTIME_ENV}
ENV PORT=3000
ENV GLOBAL_PREFIX_URI=/
ENV OIDC_PATH=/oauth2
ENV ACCOUNT_PROVIDER=database

EXPOSE 3000
CMD ["node", "dist/main.js", "--sync"]
