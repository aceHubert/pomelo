# copy and rename this file to env.development.local to debug locally
# HOST="" # use default
PORT=5003
CORS=true
# # redis connection string
# # redis[s] :// [[username :] password@] host [:port][/database]
# #           [?[timeout=timeout[d|h|m|s|ms|us|ns]] [&clientName=clientName]
# #           [&libraryName=libraryName] [&libraryVersion=libraryVersion] ]
REDIS_URL: "redis://host:port/db"
# identity database connection
IDENTITY_DATABASE_CONNECTION: "mysql://user:password@host:port/database"
# table prefix
IDENTITY_DATABASE_TABLE_PREFIX: "po_"

# account provider: database | microservice
ACCOUNT_PROVIDER=database
# user database connection
USER_DATABASE_CONNECTION: "mysql://user:password@host:port/database"
USER_DATABASE_TABLE_PREFIX: "po_"
USER_MICROSERVICE_HOST=""
USER_MICROSERVICE_PORT=5000

# OIDC prefix
OIDC_PATH="/oauth2"
# OIDC debug
OIDC_DEBUG: true

# Site title
SITE_TITLE="Pomelo Identity Server"
