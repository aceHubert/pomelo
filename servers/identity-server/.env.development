# copy and rename this file to env.development.local to debug locally
# HOST="" # use default
PORT=5003
CORS=true
INFRASTRUCTURE_SERVICE_HOST=""
INFRASTRUCTURE_SERVICE_PORT=5000
# account provider: direct-db | microservice
ACCOUNT_PROVIDER=direct-db
# # redis connection string
# # redis[s] :// [[username :] password@] host [:port][/database]
# #           [?[timeout=timeout[d|h|m|s|ms|us|ns]] [&clientName=clientName]
# #           [&libraryName=libraryName] [&libraryVersion=libraryVersion] ]
REDIS_URL: "redis://host:port/db"
# identity database connection
IDENTITY_DATABASE_CONNECTION: "mysql://hubert:Hubert123@127.0.0.1:3306/po_template"
# table prefix
TABLE_PREFIX: "po_"
# OIDC prefix
OIDC_PATH="/oauth2"
# OIDC debug
OIDC_DEBUG: true
