<script src="<%= baseURL %>vendor/crypto-js/core.js"></script>
<script src="<%= baseURL %>vendor/crypto-js/sha256.js"></script>
<script>
  Object.defineProperties(String.prototype, {
    sha256: {
      value: function () {
        return CryptoJS.SHA256(this.valueOf()).toString();
      },
    },
  });
</script>
