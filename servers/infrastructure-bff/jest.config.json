{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globals": {
    "ts-jest": {
      "tsconfig": {
        "types": ["node", "jest"]
      }
    }
  },
  "moduleNameMapper": {
    "^@/(.*)": "<rootDir>/$1",
    "^@ace-nestjs/(.*)$": "<rootDir>/../../../packages/nestjs-$1/src",
    "^@ace-pomelo/shared/server$": "<rootDir>/../../../packages/pomelo-shared/src/server",
    "^@ace-pomelo/shared/server/(.*)$": "<rootDir>/../../../packages/pomelo-shared/src/server/$1"
  },
  "collectCoverageFrom": ["**/*.(t|j)s"],
  "coverageDirectory": "../coverage",
  "testEnvironment": "node"
}
