# identity-server / pomelo-oidc 独立部署配置样例

# > 基础 <
# # 内容目录，默认为：cwd()/content
# CONTENT_PATH="path/to/content"

# # 运行时启用 debugger，默认为：NODE_ENV !== "production"
# DEBUG=false

# > 服务 <
# # HTTP 监听地址，默认 0.0.0.0
# HOST="0.0.0.0"
# # HTTP 监听端口，默认 3000
# PORT=3000
# # Nest 全局路由前缀；Docker 独立镜像通常不需要配置
# GLOBAL_PREFIX_URI=""

# # 启用跨域
# CORS=true
# # 跨域白名单（配置后 CORS 为 true）
# CORS_ORIGIN="http://localhost:5011|http://localhost:5012"

# > 文档与 GraphQL <
# # swagger 启用 debugger，默认为 DEBUG 设置
# SWAGGER_DEBUG=false
# # swagger 文档路径，默认为：/doc
# SWAGGER_PATH="/doc"

# # graphql 启用 debugger，默认为 DEBUG 设置
# GRAPHQL_DEBUG=false
# # graphql 路径，默认为：/graphql
# GRAPHQL_PATH="/graphql"

# > 存储 <
# # redis connection string
# # redis[s]://[[username:]password@]host[:port][/database]
# REDIS_URL="redis://host:port/db"

# # identity database connection
# # direct-db 模式下需要指向 infrastructure-service 用户表所在数据库
# IDENTITY_DATABASE_CONNECTION="mysql://user:password@host:port/database"
# # table prefix
# TABLE_PREFIX="po_"

# > 账号提供方 <
# # 默认 direct-db：直接读取数据库 users / usermeta
# # 自定义账号服务时配置 microservice
# ACCOUNT_PROVIDER="direct-db"

# # microservice 模式才需要配置 infrastructure-service TCP 连接
# INFRASTRUCTURE_SERVICE_HOST="127.0.0.1"
# INFRASTRUCTURE_SERVICE_PORT=3001

# > OpenID Connect <
# # oidc-provider debug
# OIDC_DEBUG=false
# # OpenID Connect 路径，默认为：/oauth2
# OIDC_PATH="/oauth2"

# # public key, for jwt verification
# JWT_PUBLIC_KEY="public_key"
# # private key, for jwt signing & generate oidc jwks
# JWT_PRIVATE_KEY="private_key"

# # 本地创建 jwt token
# # jwt 签名类型，默认为：RS256
# JWT_ALGORITHM=RS256
# # jwt 签名失效时间，默认为：1d
# JWT_EXPIRES_IN=1d

# > 日志 <
# # 日志级别，默认为：DEBUG 开启时为 debug，否则为 info
# LOG_LEVEL="info"
# # 日志文件目录，默认为：CONTENT_PATH/../logs
# LOG_FILENAME_DIR="path/to/logs"
