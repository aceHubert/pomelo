{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "jsx": "react-jsx",
    "moduleResolution": "Node",
    "allowJs": false,
    "strict": true,
    "noUnusedLocals": false,
    "noImplicitReturns": false,
    "isolatedModules": true,
    "types": ["vite/client", "react", "react-dom"]
  },
  "include": ["src", "vite.config.ts"]
}
